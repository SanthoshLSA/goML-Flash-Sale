# PostgreSQL connection string
# Local: postgres://postgres:password@localhost:5432/flashsale
# Cloud (Neon/Supabase): postgres://<user>:<pass>@<host>/flashsale?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flashsale

# Redis connection string
# Local: redis://localhost:6379
# Upstash: rediss://<user>:<pass>@<host>:6379
REDIS_URL=redis://localhost:6379

# Server port
PORT=3000

# Node environment
NODE_ENV=development
